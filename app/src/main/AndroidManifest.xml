<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Design §14: these five and nothing else. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- B-16: automatic backup checks for Wi-Fi before it starts (B-2); WorkManager already merges this one. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- WorkManager adds these two; we use neither (no foreground service, B-2; JobScheduler survives reboot on API 26+). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" tools:node="remove" />

    <!-- Not a permission: keeps phones without a camera installable (photos are optional). -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- B-09: lets the Health Connect client library see whether Health Connect is installed (Android 11 and lower). -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- B-09: what Health Connect needs from a reading app: a privacy policy screen for the permission dialog (same text as Pengaturan, PV-4) and the Android 14+ "data access" entry. No permission is added by these. -->
        <activity
            android:name=".ui.pengaturan.PrivacyPolicyActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".ui.pengaturan.PrivacyPolicyActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- Rest timer (L-8): woken by the exact alarm, posts one local notification. Not exported. -->
        <receiver
            android:name=".ui.logger.RestAlarmReceiver"
            android:exported="false" />

        <!-- Lets the camera app write one picture into the private capture cache (Saya, PV-3). Nothing else is shared. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.captures"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
